    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/AcknowledgeCount/**",
              "components/general/ActionOutcome/**",
              "components/general/Avatar/**",
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/ButtonLink/**",
              "components/general/Card/**",
              "components/general/CardColumns/**",
