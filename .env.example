# MkAuth — Local Development Environment
# Copy to .env and adjust values as needed.

# --- Backend ---
DB_DSN=postgres://mkauth:mkauth_secure_password@localhost:5432/mkauthdb?sslmode=disable
REDIS_URL=localhost:6379
PORT=8080
MKAUTH_API_KEY=dev_auth_token_secret
MKAUTH_SEED_DEMO=true
CORS_ORIGIN=http://localhost:3000

# Path to migration files (relative for local dev, absolute for Docker)
MIGRATION_PATH=file://db/migrations

# --- Frontend (UI) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
# MKAUTH_API_KEY is shared with backend above

# --- Zitadel OIDC (optional — uncomment to enable) ---
# ZITADEL_DOMAIN=your-instance.zitadel.cloud
# ZITADEL_AUDIENCE=your-pkce-client-id
# ZITADEL_CLIENT_ID=your-pkce-client-id
# ZITADEL_WEBHOOK_SECRET=your-webhook-secret

# Role key in urn:zitadel:iam:org:project:roles that grants operator access
# to the /api/v1/zitadel/* discovery and management endpoints. Default: "admin"
# ZITADEL_ADMIN_ROLE_KEY=admin

# --- Zitadel M2M / Management API (optional — uncomment for live orchestration) ---
# Service account key file for Management API access (user/grant/role CRUD).
# Add the service account as an org member (Organization > Members) with one of:
#   - ORG_OWNER                       (full access — recommended for PoC)
#   - ORG_USER_MANAGER + ORG_PROJECT_PERMISSION_EDITOR (least privilege)
#
# ZITADEL_MACHINE_KEY_PATH is a HOST path (relative paths resolve against the
# docker-compose.yml directory). Compose bind-mounts this file to a fixed
# internal path inside the container — you never need to set that yourself.
# Leave unset to run in local-policy-only mode (no Management API calls).
# ZITADEL_MACHINE_KEY_PATH=./zitadel-machine-key.json
