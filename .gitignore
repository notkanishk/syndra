# OS
.DS_Store
.cache/

# Go
bin/
/backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/backend/.gocache/
/backend/.gomodcache/
/backend/vendor/
# CLI binaries from stray `go build ./cmd/<name>` invocations inside backend/.
# The cmd packages are run via `go run`; persistent binaries here are
# accidental artifacts, not intentional outputs.
/backend/api
/backend/test
/backend/syndra-token

# Node/Next.js
/ui/node_modules/
/ui/.next/
# Incremental typecheck cache — rewritten by every build, useful to nobody reading a diff.
/ui/tsconfig.tsbuildinfo
/ui/out/
/ui/build/
/ui/.swc/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Zitadel Machine Key (CRITICAL: Do not commit this)
zitadel-machine-key.json
*/zitadel-machine-key.json

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Local assistant/index state.
#
# These are caches and machine-specific config, not project content: they are
# rebuilt from the source tree on demand and are keyed to one checkout's
# absolute path, so a committed copy is stale for everyone but its author.
# The assistant *documentation* that is worth sharing — CLAUDE.md, AGENTS.md,
# and the reusable workflows under .claude/ — stays tracked.
.openlore/
.serena/
.codebase-memory/
.codex/

# Deployment values specific to one installation (host addresses, real
# hostnames). DEPLOY.md is written against placeholders; this is where an
# operator keeps the substitutions for their own network.
DEPLOY.local.md

# Design-tool exports. Large binaries that belong in the design handoff, not
# in git history.
*.zip

# Built add-on binaries.
addons/*/truenas
