{
  "$comment": "Every operation id in the backend's operationPolicy. scope is the broadest scope it may be offered at (the ceiling); confirm is whether the backend requires confirmation.",
  "operations": {
    "account.adopt": {
      "scope": "admin",
      "confirm": true,
      "params": [
        {
          "name": "username",
          "type": "string",
          "required": true,
          "secret": false
        }
      ],
      "secret_params": []
    },
    "account.purge": {
      "scope": "admin",
      "confirm": true,
      "params": [
        {
          "name": "elevated_key",
          "type": "string",
          "required": true,
          "secret": true
        }
      ],
      "secret_params": [
        "elevated_key"
      ]
    },
    "account.release": {
      "scope": "admin",
      "confirm": true,
      "params": [],
      "secret_params": []
    },
    "activity.get": {
      "scope": "admin",
      "confirm": false,
      "params": [
        {
          "name": "since",
          "type": "string",
          "required": false,
          "secret": false
        }
      ],
      "secret_params": []
    },
    "health.get": {
      "scope": "admin",
      "confirm": false,
      "params": [],
      "secret_params": []
    },
    "password.rotate": {
      "scope": "admin",
      "confirm": true,
      "params": [],
      "secret_params": []
    },
    "password.set": {
      "scope": "member",
      "confirm": false,
      "params": [
        {
          "name": "password",
          "type": "string",
          "required": true,
          "secret": true
        }
      ],
      "secret_params": [
        "password"
      ]
    },
    "storage.status": {
      "scope": "member",
      "confirm": false,
      "params": [],
      "secret_params": []
    }
  }
}
