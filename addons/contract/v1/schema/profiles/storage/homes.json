{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/1/schema/profiles/storage/homes.json",
  "title": "Homes",
  "description": "GET /homes. Every account with a home folder in a considered share, with its use.",
  "type": "object",
  "properties": {
    "homes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "uid": {
            "type": "integer"
          },
          "home": {
            "type": "string"
          },
          "used_bytes": {
            "type": "integer"
          },
          "quota_bytes": {
            "type": "integer",
            "description": "Absent when no limit is set."
          }
        },
        "required": [
          "username",
          "uid",
          "home",
          "used_bytes"
        ]
      }
    },
    "usage_read": {
      "type": "boolean",
      "description": "False when a dataset's quota table could not be read; homes are still listed, with no use."
    }
  },
  "required": [
    "homes",
    "usage_read"
  ]
}
