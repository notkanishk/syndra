{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/1/schema/operation_response.json",
  "title": "Operation response",
  "description": "POST /operations/{name} reply. Thin by design: there is no field for the target's error payload. At most one of activity, storage and health is present, by operation.",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "$ref": "common/outcome.json"
    },
    "detail": {
      "type": "string"
    },
    "rotated": {
      "type": "boolean",
      "description": "A new credential was minted and applied; its value is nowhere."
    },
    "activity": {
      "$ref": "#/$defs/ActivityReport"
    },
    "storage": {
      "$ref": "#/$defs/StorageStatus"
    },
    "health": {
      "$ref": "#/$defs/TargetHealth"
    },
    "account_uid": {
      "type": "integer",
      "description": "The unix identity of the account an adoption bound."
    }
  },
  "required": [
    "operation",
    "subject",
    "outcome"
  ],
  "$defs": {
    "ActivityReport": {
      "type": "object",
      "description": "activity.get payload.",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "description": "When the event happened."
              },
              "event": {
                "type": "string"
              },
              "share": {
                "type": "string"
              },
              "success": {
                "type": "boolean"
              },
              "address": {
                "type": "string",
                "description": "Where it came from."
              },
              "detail": {
                "type": "string",
                "description": "The target's own status token, e.g. NT_STATUS_NO_SUCH_USER; only a token."
              }
            },
            "required": [
              "at",
              "event",
              "success"
            ]
          }
        },
        "uncovered_shares": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Shares that were not watching this member."
        },
        "truncated": {
          "type": "boolean",
          "description": "Older events exist than the newest returned."
        }
      },
      "required": [
        "events"
      ]
    },
    "StorageStatus": {
      "type": "object",
      "description": "storage.status payload: a member's own account state and usage.",
      "properties": {
        "username": {
          "type": "string"
        },
        "usable": {
          "type": "boolean",
          "description": "The member can connect right now."
        },
        "needs_password": {
          "type": "boolean"
        },
        "smb_enabled": {
          "type": "boolean"
        },
        "shares": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "share": {
                "type": "string"
              },
              "used_bytes": {
                "type": "integer"
              },
              "quota_bytes": {
                "type": "integer",
                "description": "Absent when no quota is set."
              }
            },
            "required": [
              "share",
              "used_bytes"
            ]
          }
        },
        "usage_readable": {
          "type": "boolean",
          "description": "False is 'could not look', never 'nothing used'."
        },
        "needs_new_password": {
          "type": "boolean"
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "profiles/storage/reach.json#/$defs/Place"
          }
        },
        "places_readable": {
          "type": "boolean"
        }
      },
      "required": [
        "username",
        "usable",
        "needs_password",
        "smb_enabled",
        "shares",
        "usage_readable",
        "needs_new_password",
        "places",
        "places_readable"
      ]
    },
    "TargetHealth": {
      "type": "object",
      "description": "health.get payload: the target's system, alerts, pools and services; a partial answer names what is missing.",
      "properties": {
        "system": {
          "type": "object",
          "description": "The target identifying itself.",
          "properties": {
            "hostname": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "uptime_seconds": {
              "type": "number"
            }
          },
          "required": []
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string"
              },
              "klass": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "The alert's own prose, markup removed."
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "description": "When it was raised."
              },
              "dismissed": {
                "type": "boolean"
              }
            },
            "required": [
              "level",
              "text",
              "dismissed"
            ]
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "healthy": {
                "type": "boolean"
              },
              "warning": {
                "type": "boolean"
              },
              "free_bytes": {
                "type": "integer"
              },
              "allocated_bytes": {
                "type": "integer"
              },
              "size_bytes": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "status",
              "healthy",
              "warning",
              "free_bytes",
              "allocated_bytes",
              "size_bytes"
            ]
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "enable": {
                "type": "boolean",
                "description": "Starts on boot."
              }
            },
            "required": [
              "service",
              "state",
              "enable"
            ]
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The sources that could not be read."
        }
      },
      "required": []
    }
  }
}
