{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/1/schema/setting.json",
  "title": "Setting",
  "description": "One system-wide setting: its value, who set it, and what it may be. The reply of PUT /settings/{name} and each entry of GET /settings.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The setting's name, e.g. home_root."
    },
    "label": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "description": "Empty means not chosen."
    },
    "set_by": {
      "type": "string",
      "description": "The actor who last set it."
    },
    "set_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was last set."
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What it may be, read from the target."
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Value to the way a person says it."
    },
    "values_read": {
      "type": "boolean",
      "description": "False is 'could not read', never 'nothing'."
    }
  },
  "required": [
    "name",
    "label",
    "value",
    "values",
    "values_read"
  ]
}
