{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/2/schema/profiles/storage/homes.json",
  "title": "Homes",
  "description": "GET /homes (feature storage.homes, kind storage). Every account with a home folder in a considered share, with its use: the storage kind's current usage query.",
  "type": "object",
  "properties": {
    "homes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "account_id": {
            "$ref": "../../common/field.json#/$defs/AccountId"
          },
          "home": {
            "type": "string"
          },
          "used_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "quota_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "username",
          "account_id",
          "home",
          "used_bytes"
        ]
      }
    },
    "quota_read": {
      "type": "boolean",
      "description": "Completeness (today's usage_read): false means a quota table could not be read and the homes are listed live with no use, a partial read and not a stale one."
    },
    "taken_at": {
      "type": "string",
      "format": "date-time"
    },
    "current": {
      "type": "boolean"
    },
    "stale": {
      "$ref": "../../common/stale.json"
    }
  },
  "required": [
    "homes",
    "quota_read",
    "taken_at",
    "current"
  ],
  "allOf": [
    {
      "$ref": "../../common/stale.json#/$defs/Invariant"
    }
  ]
}
