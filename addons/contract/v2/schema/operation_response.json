{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/2/schema/operation_response.json",
  "title": "Operation response",
  "description": "POST /operations/{name} reply. Thin by design: there is no field for the target's error payload. A feature-results add-on answers result; the typed pockets (activity, storage, health) are read only from an add-on without it and go at the next major.",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "$ref": "common/outcome.json"
    },
    "detail": {
      "type": "string"
    },
    "rotated": {
      "type": "boolean"
    },
    "account_id": {
      "$ref": "common/field.json#/$defs/AccountId",
      "description": "The id of the account an adoption bound."
    },
    "result": {
      "type": "object",
      "description": "Feature results. Validated against the schema registry/operations.json names for the operation: common/records.json, common/activity.json, common/status.json, or its own.",
      "x-feature": "results"
    },
    "activity": {
      "$ref": "#/$defs/ActivityReport"
    },
    "storage": {
      "$ref": "#/$defs/StorageStatus"
    },
    "health": {
      "$ref": "#/$defs/TargetHealth"
    }
  },
  "required": [
    "operation",
    "subject",
    "outcome"
  ],
  "$defs": {
    "ActivityReport": {
      "type": "object",
      "description": "Legacy pocket: activity.get payload.",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "event": {
                "type": "string"
              },
              "share": {
                "type": "string"
              },
              "success": {
                "type": "boolean"
              },
              "address": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "at",
              "event",
              "success"
            ]
          }
        },
        "uncovered_shares": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "events"
      ]
    },
    "StorageStatus": {
      "type": "object",
      "description": "Legacy pocket: storage.status payload.",
      "properties": {
        "username": {
          "type": "string"
        },
        "usable": {
          "type": "boolean"
        },
        "needs_password": {
          "type": "boolean"
        },
        "smb_enabled": {
          "type": "boolean"
        },
        "shares": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "share": {
                "type": "string"
              },
              "used_bytes": {
                "type": "integer"
              },
              "quota_bytes": {
                "type": "integer"
              }
            },
            "required": [
              "share",
              "used_bytes"
            ]
          }
        },
        "usage_readable": {
          "type": "boolean"
        },
        "needs_new_password": {
          "type": "boolean"
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "profiles/storage/reach.json#/$defs/Place"
          }
        },
        "places_readable": {
          "type": "boolean"
        },
        "standing": {
          "$ref": "common/standing.json",
          "description": "The subject's own account's standing, as the subjects read would report it: what the member's page says about their account without a full subjects read."
        }
      },
      "required": [
        "username",
        "usable",
        "needs_password",
        "smb_enabled",
        "shares",
        "usage_readable",
        "needs_new_password",
        "places",
        "places_readable",
        "standing"
      ]
    },
    "TargetHealth": {
      "type": "object",
      "description": "Legacy pocket: health.get payload.",
      "properties": {
        "system": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "uptime_seconds": {
              "type": "number"
            }
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string"
              },
              "klass": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "dismissed": {
                "type": "boolean"
              }
            },
            "required": [
              "level",
              "text",
              "dismissed"
            ]
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "healthy": {
                "type": "boolean"
              },
              "warning": {
                "type": "boolean"
              },
              "free_bytes": {
                "type": "integer"
              },
              "allocated_bytes": {
                "type": "integer"
              },
              "size_bytes": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "status",
              "healthy",
              "warning",
              "free_bytes",
              "allocated_bytes",
              "size_bytes"
            ]
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "enable": {
                "type": "boolean"
              }
            },
            "required": [
              "service",
              "state",
              "enable"
            ]
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
