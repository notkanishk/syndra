{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/1/schema/lifecycle_response.json",
  "title": "Lifecycle response",
  "description": "POST /lifecycle reply.",
  "type": "object",
  "properties": {
    "state": {
      "$ref": "lifecycle_request.json#/$defs/LifecycleState"
    },
    "reason": {
      "type": "string"
    },
    "in_flight": {
      "type": "integer",
      "description": "What an operator waits on before pulling a credential.",
      "minimum": 0
    },
    "drained": {
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "reason",
    "in_flight",
    "drained"
  ]
}
