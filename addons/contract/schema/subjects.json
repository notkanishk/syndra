{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndra.example.org/addon-contract/1/schema/subjects.json",
  "title": "Subjects",
  "description": "GET /subjects. Every account the target holds, in entitlement vocabulary, and how far to trust the read.",
  "type": "object",
  "properties": {
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Subject"
      }
    },
    "current": {
      "type": "boolean",
      "description": "Read from the target just now rather than from the add-on's mirror."
    },
    "taken_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the read happened."
    },
    "truncated": {
      "type": "boolean",
      "description": "The read hit its cap; it cannot support a conclusion about absence."
    }
  },
  "required": [
    "subjects",
    "current",
    "taken_at",
    "truncated"
  ],
  "$defs": {
    "Subject": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "integer",
            "string"
          ],
          "description": "The target's record key."
        },
        "username": {
          "type": "string"
        },
        "uid": {
          "type": "integer",
          "description": "The target's stable identity for the account; survives a rename."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "home": {
          "type": "string",
          "description": "Where the account's home folder is; absent when it has none."
        },
        "enabled": {
          "type": "boolean"
        },
        "smb_enabled": {
          "type": "boolean"
        },
        "password_set": {
          "type": "boolean",
          "description": "The account has a usable credential."
        },
        "self": {
          "type": "boolean",
          "description": "The add-on's own service account; it refuses to adopt or purge it."
        },
        "state": {
          "$ref": "common/field.json#/$defs/ReportedValues",
          "description": "The account's current values by entitlement field, in the manifest's vocabulary."
        }
      },
      "required": [
        "id",
        "username",
        "uid",
        "groups",
        "enabled",
        "smb_enabled",
        "password_set",
        "state"
      ]
    }
  }
}
