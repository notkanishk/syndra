  "write_rules": [
    {
      "case": "create with no credential decision",
      "method": "user.create",
      "refused_fields": [
        "user_create.password"
      ],
      "code": -32602
    },
    {
      "case": "create with smb and disabled password",
      "method": "user.create",
      "refused_fields": [
        "user_create.password_disabled"
      ],
      "code": -32602
    },
    {
      "case": "create with password auth disabled",
      "method": "user.create",
      "accepted": true
    },
    {
      "case": "user.create returns",
      "returns": "record",
      "keys": [
        "api_keys",
        "builtin",
        "email",
        "full_name",
        "group",
        "groups",
        "home",
        "id",
        "immutable",
        "last_password_change",
        "local",
        "locked"
      ]
    },
    {
      "case": "password alone leaves auth disabled",
      "method": "user.update",
      "accepted": true
    },
    {
      "case": "password alone, resulting password_disabled",
      "password_disabled": true
    },
    {
      "case": "enable smb in a later call",
      "method": "user.update",
      "refused_fields": [
        "user_update.password_disabled",
        "user_update.smb"
      ],
      "code": -32602
    },
    {
      "case": "password, enable auth and smb together",
      "method": "user.update",
      "accepted": true
    }
  ],
